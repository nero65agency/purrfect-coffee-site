---
import "../styles/site.css";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookingDialog from "../components/BookingDialog.astro";
import { settings, hours, catWord, bookingOn, payOnArrival, photos, facebookUrl } from "../lib/content";

// Details Google can read (opening hours, address, phone) for search results.
const dayCode: Record<string, string> = { Monday: "Mo", Tuesday: "Tu", Wednesday: "We", Thursday: "Th", Friday: "Fr", Saturday: "Sa", Sunday: "Su" };
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: "The Purr-fect Coffee Shop",
  description: "Cat café in Skegness",
  telephone: settings.phone,
  url: Astro.site?.toString(),
  image: new URL("/uploads/site/logo.jpg", Astro.site).toString(),
  address: { "@type": "PostalAddress", streetAddress: "18 High Street", addressLocality: "Skegness", postalCode: "PE25 3NW", addressCountry: "GB" },
  openingHours: (hours.days ?? []).filter((d: any) => !d.closed).map((d: any) => `${dayCode[d.day]} ${d.open}-${d.close}`),
  sameAs: facebookUrl ? [facebookUrl] : [],
};

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "The Purr-fect Coffee Shop | Cat café in Skegness",
  description = `Skegness's cat café on the High Street. Spend an hour with our ${catWord} resident cats, with coffee, cake and light lunches. From ${settings.entry?.weekday ?? "£5"} per person.`,
} = Astro.props;

// Read by the page script for the live open/closed status, week table and booking screen.
const siteData = {
  days: hours.days ?? [],
  entry: settings.entry ?? {},
  rules: settings.rules ?? {},
  payOnArrival,
  bookingOn,
};
---
<!doctype html>
<html lang="en-GB" data-theme="light" style="color-scheme:only light;background:#FFFFFF">
<head>
<meta charset="utf-8">
<meta name="color-scheme" content="only light">
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()}>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="/uploads/site/logo.jpg">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={new URL(photos.hero?.[0]?.image || "/uploads/site/logo.jpg", Astro.site).toString()}>
<meta property="og:type" content="website">
<script type="application/ld+json" set:html={JSON.stringify(localBusiness)}></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<TopBar />
<Header />
<main id="top"><slot /></main>
<Footer />
<BookingDialog />
<script type="application/json" id="site-data" set:html={JSON.stringify(siteData)}></script>
<script>import "../scripts/site.js";</script>
</body>
</html>

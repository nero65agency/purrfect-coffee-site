---
import { photos, facebookUrl } from "../lib/content";
const gal = (photos.gallery ?? []).filter((p: any) => p?.image);
---
<section class="sec cream" id="gallery">
  <div class="wrap">
    <div class="headrow"><div class="head"><div class="bar"></div><h2 class="h2">Life at the café</h2></div>{facebookUrl && <a class="link" href={facebookUrl}>Follow us on Facebook</a>}</div>
    <div class="gal">{gal.map((p: any, i: number) => (
      <div class={i === 0 ? "big" : undefined}><img src={p.image} alt={p.alt || ""} style={p.position ? `object-position:${p.position}` : undefined} loading="lazy"></div>
    ))}</div>
  </div>
</section>

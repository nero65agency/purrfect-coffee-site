---
import { settings, todo, telHref } from "../lib/content";
const facebook = settings.facebookUrl || "#";
---
<section class="sec cream" id="gallery">
  <div class="wrap">
    <div class="headrow"><div class="head"><div class="bar"></div><h2 class="h2">Life at the café</h2></div><a class="link" href={facebook}>Follow us on Facebook</a></div>
    <div class="gal">
      <div class="big"><img src="/uploads/site/interior2.jpg" alt="The café with cats napping on chairs and the window sill" style="object-position:60% 50%"></div>
      <div><img src="/uploads/site/cake-counter.jpg" alt="A cat watching over the cake counter" style="object-position:center 30%"></div>
      <div><img src="/uploads/cats/nala.jpg" alt="Nala relaxing"></div>
      <div><img src="/uploads/site/friends.jpg" alt="Friends chatting over coffee with a cat asleep on a chair" style="object-position:center 70%"></div>
      <div><img src="/uploads/cats/star.jpg" alt="Star peeking out of her cat bed"></div>
    </div>
  </div>
</section>

---
import { settings, hours, telHref } from "../lib/content";
---
<div class="note"><div class="wrap topbar">{hours.note && <span class="tbx" style="font-weight:800">{hours.note}</span>}<span id="tbHours">Open today</span>{settings.topBar?.map((m: string) => <span class="tbx">{m}</span>)}<a class="tbm" href={telHref(settings.phone)}>{settings.phone}</a></div></div>

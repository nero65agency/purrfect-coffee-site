---
import { settings, todo, telHref } from "../lib/content";
---
<header class="site">
  <div class="wrap">
    <a class="logo" href="#top" aria-label="The Purr-fect Coffee Shop, home"><img src="/uploads/site/logo.jpg" alt="The Purr-fect Coffee, cat coffee shop"></a>
    <nav class="main" id="nav" aria-label="Main">
      <a href="#week">Your week</a><a href="#cats">The cats</a><a href="#menu">Menu</a><a href="#events">What's on</a><a href="#faq">FAQ</a><a href="#visit">Visit</a>
    </nav>
    <div class="hright">
      <a class="tel" href={telHref(settings.phone)}>{settings.phone}</a>
      <button class="btn book hbtn" data-book type="button">Book a visit</button>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav" id="menuBtn"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg></button>
    </div>
  </div>
</header>

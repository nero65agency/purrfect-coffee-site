---
import { settings, todo, telHref, eventLive, facebookUrl } from "../lib/content";
const parties = eventLive("birthday-parties");
const tea = eventLive("afternoon-tea");
const topics = ["questions", "feedback", parties && "parties", tea && "afternoon tea", "sponsorship"].filter(Boolean) as string[];
const topicLine = (topics.slice(0, -1).join(", ") + " or " + topics[topics.length - 1]).replace(/^./, (c) => c.toUpperCase()) + ".";
---
<section class="sec cream" id="contact">
  <div class="wrap split" style="align-items:start">
    <div class="txt" style="grid-column:span 5">
      <div class="bar"></div><h2 class="h2">Say hello</h2>
      <p class="lede" style="margin:0">{topicLine}</p>
      <p style="margin:0;font-weight:700;line-height:1.9"><a href={telHref(settings.phone)}>{settings.phone}</a><br>{facebookUrl && <><a href={facebookUrl}>Message us on Facebook</a><br></>}{settings.email ? <a href={`mailto:${settings.email}`}>{settings.email}</a> : <span style="color:var(--soft)">{todo("", "Business email")}</span>}</p>
    </div>
    <div class="reach">
      <h3>The quickest ways to reach us</h3>
      <a class="btn book" href={telHref(settings.phone)}>Call {settings.phone}</a>
      {facebookUrl && <a class="btn ghost" href={facebookUrl} target="_blank" rel="noopener">Message us on Facebook</a>}
      {settings.email && <a class="btn ghost" href={`mailto:${settings.email}`}>Email {settings.email}</a>}
      <p>Want to sponsor a cat, or ask about a party? Call us or ask at the counter next time you visit.</p>
    </div>
  </div>
</section>

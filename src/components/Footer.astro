---
import { settings, facebookUrl } from "../lib/content";

---
<footer class="site">
  <div class="wrap">
    <div class="cols">
      <div style="display:flex;flex-direction:column;gap:12px"><img src="/uploads/site/logo.jpg" alt="The Purr-fect Coffee" style="width:110px;height:110px;border-radius:8px"><span style="font-size:15px;color:#D9C2A7">{settings.address}<br>{settings.phone}</span></div>
      <nav aria-label="Explore"><b>Explore</b><a href="/#week">Your week</a><a href="/#menu">Menu</a><a href="/#events">What's on</a><a href="/#sponsor">Sponsor a cat</a></nav>
      <nav aria-label="Help"><b>Help</b><a href="/#faq">FAQ</a><a href="/#faq">House rules</a><a href="/booking-terms">Booking terms</a><a href="/allergens">Allergen information</a></nav>
      <nav aria-label="Legal"><b>Legal</b><a href="/privacy">Privacy policy</a><a href="/cookies">Cookie policy</a>{facebookUrl && <a href={facebookUrl}>Facebook</a>}</nav>
    </div>
    <div class="base"><span>© {new Date().getFullYear()} The Purr-fect Coffee Shop, Skegness</span><span style="font-family:var(--serif);font-style:italic;font-size:24px;color:#F4E4D2">Relax, unwind, connect, smile</span></div>
  </div>
</footer>
